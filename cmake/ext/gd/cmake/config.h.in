/* Define to 1 if gd extension has AVIF support. */
#cmakedefine HAVE_GD_AVIF 1

/* Define to 1 if gd extension uses GD library bundled in PHP. */
#cmakedefine HAVE_GD_BUNDLED 1

/* Define to 1 if gd extension has FreeType support. */
#cmakedefine HAVE_GD_FREETYPE 1

/* Define to 1 if GD library has the 'gdImageGetInterpolationMethod' function
   (available as of libgd 2.1.1). */
#cmakedefine HAVE_GD_GET_INTERPOLATION 1

/* Define to 1 if gd extension has HEIF support. */
#cmakedefine HAVE_GD_HEIF 1

/* Define to 1 if gd extension has libimagequant support. */
#cmakedefine HAVE_GD_IMAGEQUANT 1

/* Define to 1 if gd extension has JPEG support. */
#cmakedefine HAVE_GD_JPG 1

/* Define to 1 if gd extension has JPEG XL support. */
#cmakedefine HAVE_GD_JXL 1

/* Define to 1 if GD library has the 'gdVersionString' function (available as
   of libgd 2.1.1). */
#cmakedefine HAVE_GD_LIBVERSION 1

/* Define to 1 if gd extension has PNG support. */
#cmakedefine HAVE_GD_PNG 1

/* Define to 1 if GD library has the 'gdPngGetVersionString' function
   (available as of libgd 2.4.0). */
#cmakedefine HAVE_GD_PNG_GET_VERSION_STRING 1

/* Define to 1 if gd extension has TIFF support. */
#cmakedefine HAVE_GD_TIFF 1

/* Define to 1 if gd extension has UltraHDR support. */
#cmakedefine HAVE_GD_UHDR 1

/* Define to 1 if gd extension has WebP support. */
#cmakedefine HAVE_GD_WEBP 1

/* Define to 1 if gd extension has XPM support. */
#cmakedefine HAVE_GD_XPM 1

/* Define to 1 if you have the <iconv.h> header. */
#cmakedefine HAVE_ICONV_H 1

/* Define to 1 if <iconv.h> defines iconv_t. This is obsolete since any
   <iconv.h> header provides an iconv_t typedef. */
#cmakedefine HAVE_ICONV_T_DEF 1

/* Define to 1 if you have the libavif library. */
#cmakedefine HAVE_LIBAVIF 1

/* Define to 1 if you have the FreeType library. */
#cmakedefine HAVE_LIBFREETYPE 1

/* Define to 1 if gd extension uses external system GD library. */
#cmakedefine HAVE_LIBGD 1

/* Define to 1 if you have the libheif library. */
#cmakedefine HAVE_LIBHEIF 1

/* Define to 1 if you have the libimagequant library. */
#cmakedefine HAVE_LIBIMAGEQUANT 1

/* Define to 1 if you have the libjpeg library. */
#cmakedefine HAVE_LIBJPEG 1

/* Define to 1 if you have the libjxl library. */
#cmakedefine HAVE_LIBJXL 1

/* Define to 1 if you have the libpng library. */
#cmakedefine HAVE_LIBPNG 1

/* Define to 1 if you have the libtiff library. */
#cmakedefine HAVE_LIBTIFF 1

/* Define to 1 if you have the libuhdr library. */
#cmakedefine HAVE_LIBUHDR 1

/* Define to 1 if you have the libwebp library. */
#cmakedefine HAVE_LIBWEBP 1

/* Define to 1 if you have the xpm library. */
#cmakedefine HAVE_LIBXPM 1

/* Define to 1 if you have the xpm library (obsolete and unused in php-src as
   of the bundled libgd 2.4 update in PHP-8.6). */
#cmakedefine HAVE_XPM 1

/* Define to 1 if GD library has JIS-mapped Japanese font support. */
#cmakedefine JISX0208 1

/* Define to 1 if gd extension has JIS-mapped Japanese font support. */
#cmakedefine USE_GD_JISX0208 1
